	journal = {Geophysical Research Letters},
	author = {De Plaen, Raphael S. M. and Lecocq, Thomas and Caudron, Corentin and Ferrazzini, Valérie and Francis, Olivier},
	month = aug,
	year = {2016},
	pages = {8511--8518},
}
